[run]
source = weebot
omit =
    weebot/tests/*
    weebot/GitNexus-main/*
    weebot/qmd_integration/*
    weebot/iterance-master/*
    */__pycache__/*
    *.egg-info/*

[report]
# Overall threshold — set to the measured actual (53%) minus a small
# margin so the gate is enforceable today and can be ratcheted upward.
# A floor above actual coverage is not a gate: it is a permanently red
# build that gets ignored. Raise this as coverage improves.
fail_under = 52

# Per-layer thresholds (enforced via CI, not ini)
# domain: 90, application: 80, infrastructure: 70, tools: 65, interfaces: 50

exclude_lines =
    pragma: no cover
    def __repr__
    def __str__
    raise NotImplementedError
    if __name__ == "__main__":
    pass
    @abc.abstractmethod
    @abstractmethod
    def __post_init__
    TYPE_CHECKING

ignore_errors = True

[html]
directory = coverage_html
