[importlinter]
root_package = weebot
include_external_packages = True

[importlinter:contract:domain-purity]
name = Domain layer must not depend on outer layers
type = forbidden
source_modules = weebot.domain
forbidden_modules =
    weebot.infrastructure
    weebot.application
    weebot.interfaces
    weebot.core
    weebot.tools

[importlinter:contract:tools-no-db]
name = Tools must not access databases directly
type = forbidden
source_modules = weebot.tools
forbidden_modules =
    sqlite3
ignore_imports =
    # Scheduling uses its own sqlite3 connection for cron jobs.
    weebot.scheduling.scheduler -> sqlite3
    # schedule_tool invokes the scheduler, which lazily wires DI at runtime.
    weebot.tools.schedule_tool -> weebot.scheduling.scheduler
    # persistent_memory lazily instantiates SQLiteStateRepository for salience
    # tracking. Pre-audited — ADR-ARCH-AUDIT-V2 A2 (same edge as tools-no-infra).
    weebot.tools.persistent_memory -> weebot.infrastructure.persistence.sqlite_state_repo

[importlinter:contract:tools-no-infra]
name = Tools must not bypass ports — no direct persistence or adapter imports
type = forbidden
source_modules = weebot.tools
forbidden_modules =
    weebot.infrastructure
ignore_imports =
    # persistent_memory directly manages filesystem-based memory persistence
    # (non-DB, non-adapter). The filesystem store is an I/O detail that cannot
    # go through ports without adding indirection that gains nothing.
    weebot.tools.persistent_memory -> weebot.infrastructure.persistence.filesystem_memory
    # persistent_memory lazily instantiates SQLiteStateRepository for salience
    # tracking (same edge already exempted under tools-no-db above).
    # PR #46 had removed this entry after rewriting the import to go through
    # importlib; that rewrite was not kept on merge, because the lazy
    # construction keys off `self._salience_repo is None` and the dynamic
    # version's `hasattr` guard can never be False — __init__ always sets the
    # attribute, so the repo would stay None and every salience write would
    # fail. Static import retained, so the exemption is retained with it.
    weebot.tools.persistent_memory -> weebot.infrastructure.persistence.sqlite_state_repo
    # search_history queries the FTS5 index for session search — the FTS5
    # adapter is a capability query, not a DB bypass for writes.
    weebot.tools.search_history -> weebot.infrastructure.persistence.fts5_search
    weebot.tools.search_history -> weebot.infrastructure.persistence.connection_pool
    # atomic_mail_tool delegates to the Atomic Mail MCP server adapter.
    weebot.tools.atomic_mail_tool -> weebot.infrastructure.adapters.atomicmail.mcp_server
    # apify_presets uses the Apify service adapter for actor execution.
    weebot.tools.apify_presets -> weebot.infrastructure.adapters.apify.apify_service
    # schedule_tool → scheduler → DI → adapters&persistence (transitive).
    weebot.tools.schedule_tool -> weebot.scheduling.scheduler
    # advanced_browser delegates browser operations to the session manager.
    weebot.tools.advanced_browser -> weebot.infrastructure.browser.session_manager
    weebot.tools.advanced_browser -> weebot.infrastructure.browser.playwright_adapter
    weebot.tools.advanced_browser -> weebot.infrastructure.browser.content_extractor
    # browser_inspector delegates to Playwright for DOM inspection.
    weebot.tools.browser_inspector -> weebot.infrastructure.browser.playwright_adapter
    weebot.tools.browser_inspector -> weebot.infrastructure.browser.som_renderer
    # browser_tool wraps the DI-injected LLMPort in a LangChain adapter for
    # browser_use. This line was commented out, above a comment claiming the
    # import went undetected because it is "lazy inside a function". That was
    # the wrong reason: grimp sees function-level imports fine. It was
    # undetected because weebot/infrastructure/llm/ had no __init__.py, and a
    # namespace package is left out of grimp's graph entirely -- one of 11 such
    # directories, 44 modules no contract could see (phase 3.3). With the
    # package markers added, this is the only violation they were hiding.
    weebot.tools.browser_tool -> weebot.infrastructure.llm.langchain_adapter
    # file_editor uses security validators directly (pre-audited, Phase C candidate).
    weebot.tools.file_editor -> weebot.infrastructure.security.security_validators
    # bash/powershell/python tools create sandbox instances via the factory.
    weebot.tools.bash_tool -> weebot.infrastructure.sandbox.factory
    weebot.tools.powershell_tool -> weebot.infrastructure.sandbox.factory
    weebot.tools.python_tool -> weebot.infrastructure.sandbox.factory
    # swarm tool lazily imports the Swarm event bus.
    weebot.tools.swarm -> weebot.infrastructure.swarm_event_bus
    # tool_collection increments tool-call metrics via the metrics_bridge
    # (the designated bridge between application models and infrastructure).
    weebot.application.models.tool_collection -> weebot.application.services.metrics_bridge

[importlinter:contract:infra-no-app-services]
name = Infrastructure must depend on ports, not application services/flows/agents
type = forbidden
source_modules = weebot.infrastructure
forbidden_modules =
    weebot.application.agents
    weebot.application.flows
    weebot.application.services
    weebot.application.cqrs
    weebot.application.di
ignore_imports =
    # Apify actor registry wraps the Apify tool for actor-level discovery.
    weebot.infrastructure.adapters.apify.actor_registry -> weebot.tools.apify_actor_tool
    # Interface customization reads profile settings from the application service.
    weebot.infrastructure.interface_customization -> weebot.application.services.profile_manager
    # MCP tool bridge implements the MCP tool port defined in application.ports.
    weebot.infrastructure.mcp.mcp_tool_bridge -> weebot.application.ports.mcp_tool_port
    # (moved — sqlite_state_repo -> domain.services.commitment_extractor is
    #  architecturally correct and requires no ignore_imports entry.)

[importlinter:contract:interfaces-no-infra]
name = Interfaces must not depend on infrastructure adapters directly
type = forbidden
source_modules = weebot.interfaces
forbidden_modules =
    weebot.infrastructure
    weebot.tools
ignore_imports =
    # ---- Composition root: interfaces wire up the full application stack ----
    # Web server bootstraps DI and wires LLM + metrics at startup.
    weebot.interfaces.web.main -> weebot.application.di
    weebot.interfaces.web.main -> weebot.infrastructure.observability.metrics
    weebot.interfaces.web.main -> weebot.scheduling.default_jobs
    # Web routers use DI to resolve services per-request.
    weebot.interfaces.web.routers.chat_router -> weebot.application.di
    weebot.interfaces.web.routers.discord_webhook -> weebot.application.di
    weebot.interfaces.web.routers.slack_webhook -> weebot.application.di
    weebot.interfaces.web.routers.whatsapp_webhook -> weebot.application.di
    weebot.interfaces.web.routers.health -> weebot.application.di
    weebot.interfaces.web.routers.ops_router -> weebot.application.cqrs.mediator
    # CLI agent_runner -> ToolCollection -> metrics_bridge is the same
    # designated application-model -> infrastructure bridge already
    # exempted by the tools-no-infra contract; break the chain here too.
    weebot.application.models.tool_collection -> weebot.application.services.metrics_bridge
    # Composition root: main.py configures structured logging at startup
    # (same category as the metrics wiring exempted above).
    weebot.interfaces.web.main -> weebot.infrastructure.observability.logging_config
    # Rate-limit middleware emits Prometheus counters and audit events —
    # observability/audit wiring, same category as the metrics edge above.
    weebot.interfaces.web.rate_limit -> weebot.infrastructure.observability.metrics
    weebot.interfaces.web.rate_limit -> weebot.infrastructure.security.audit_logger
    weebot.interfaces.web.routers.webhook -> weebot.application.di
    # Factories wire up the full tool set (composition root).
    weebot.interfaces.factories -> weebot.application.di
    weebot.interfaces.factories -> weebot.application.flows.flow_builder
    weebot.interfaces.factories -> weebot.application.flows.plan_act_flow
    # The tool registry is application policy (plan 3.2) that discovers tool classes
    # in weebot.tools by name; importing it is how the CLI/web build a tool collection.
    weebot.interfaces.factories -> weebot.application.services.tool_registry
    # CLI agent runner resolves services from DI.
    # Gateway adapters use DI fallback for SafetyChecker LLMPort.
    # Windows-specific interfaces wire native platform adapters.
    weebot.interfaces.windows -> weebot.infrastructure.adapters.windows_desktop
    weebot.interfaces.windows_toast_subscriber -> weebot.infrastructure.notifications.notifications
    # Shutdown handler closes all DB connection pools to prevent leaks.
    weebot.interfaces.web.main -> weebot.infrastructure.persistence.connection_pool
    # Web server wires PrometheusMetricsAdapter as a DI lookup key for /metrics.
    # (PrometheusMetricsAdapter is registered as the concrete key in DI.)
    weebot.interfaces.web.main -> weebot.infrastructure.observability.prometheus_adapter
    # Health router wires PrometheusMetricsAdapter as a DI lookup key for /metrics/prometheus.
    weebot.interfaces.web.routers.health -> weebot.infrastructure.observability.prometheus_adapter
    # Factories import PlanActFlowConfig for the sub-agent flow factory.
    weebot.interfaces.factories -> weebot.application.models.plan_act_flow_config
    # via importlib.import_module (dynamic) — undetectable by lint-imports
    # `doctor` is a read-only diagnostic composition root (same category as
    # the browser_use/playwright/mcp find_spec probes already in this file);
    # it needs LatexCompilerService.missing_fonts()/toolchain_available() to
    # report the latex_fonts check (finding E5).
    weebot.interfaces.cli.support -> weebot.infrastructure.document.latex_compiler


[importlinter:contract:core-no-app]
name = Core cross-cutting layer must not depend on application
type = forbidden
source_modules = weebot.core
forbidden_modules =
    weebot.application
    weebot.interfaces
ignore_imports =
    # safety.py uses LLMPort (port, not concrete adapter).  Acceptable per
    # ADR-009: "port interfaces in core are allowed; framework deps are not."
    weebot.core.safety -> weebot.application.ports.llm_port

[importlinter:contract:config-is-leaf]
# Plan 3.9 (Q8). Configuration is data; it sits under every layer. It used to
# import an application enum and build an application service, which is how
# settings ended up depending on the code they configure. No exemptions.
name = Config is a leaf: it must not import application, interfaces, infrastructure or tools
type = forbidden
source_modules =
    weebot.config
forbidden_modules =
    weebot.application
    weebot.interfaces
    weebot.infrastructure
    weebot.tools

[importlinter:contract:app-no-interfaces]
name = Application layer must not depend on interfaces
type = forbidden
source_modules = weebot.application
forbidden_modules =
    weebot.interfaces
# No exemptions (plan 3.7): the composition root builds flows through
# application/flows/flow_builder.py and no longer imports the interfaces layer.
# Everything in application/ receives collaborators by injection -- see
# CronAgentRunner.flow_factory and BenchmarkRunner.flow_factory.

[importlinter:contract:app-no-infrastructure]
# WB-01 of tasks/specs/arch_audit_2026_10_wave2_remediation_plan.md. Every other
# arrow of the inward rule had a contract; this one had none. `application` speaks
# to providers through ports and receives adapters by injection, and the only thing
# checking it was an AST test scoped to application/services/ with a *filename*
# allowlist -- so a new infrastructure import inside one of those seven files was
# invisible. Measured when this contract was added: 47 direct
# application->infrastructure edges, 42 of them in the composition root.
#
# `weebot.application.di` is deliberately NOT a source module: it is the composition
# root, the one place adapters are constructed, and enumerating its 42 edges as
# exemptions would put 42 more lines in this file to say what the directory name
# already says. The gap that leaves -- a new application/ subpackage that nothing
# governs -- is closed by
# tests/unit/test_architecture_fitness.py::test_every_application_subpackage_is_under_the_inward_contract,
# which fails until the new subpackage is listed below (same default-deny shape as
# unassigned-no-infra).
#
# Direct imports only, like app-no-vendor-sdks: chains that run through a port are
# the design, and checking them would flag every correct route.
name = Application must depend on ports, not on infrastructure
type = forbidden
allow_indirect_imports = True
source_modules =
    weebot.application.abstractions
    weebot.application.agents
    weebot.application.cqrs
    weebot.application.document
    weebot.application.eval
    weebot.application.flows
    weebot.application.harness
    weebot.application.middleware
    weebot.application.models
    weebot.application.ports
    weebot.application.services
    weebot.application.skills
    weebot.application.strategies
    weebot.application.termination
    weebot.application.use_cases
forbidden_modules =
    weebot.infrastructure
ignore_imports =
    # None. The four edges this contract first caught were fixed rather than excused:
    # two were services defaulting to a concrete adapter (now ports:
    # VectorStorePort, ClawHubAdapterPort, StrategyStorePort, SkillStorePort) and one
    # was a collaborator nothing called, deleted with its parameter.

[importlinter:contract:unassigned-no-infra]
# Phase 3.3 of tasks/specs/arch_audit_2026_09_remediation_plan.md -- the
# default-deny contract. Every other contract is scoped to a layer directory,
# so a package outside those directories was governed by nothing, and moving
# code into one removed its governance with no gate firing. These nine held
# about 19,000 lines and nine direct edges into infrastructure and tools.
#
# A fitness test (test_every_top_level_package_is_under_a_contract) fails on
# any NEW top-level package until it is added here or to a layer contract, so
# packages are governed by default rather than by omission. import-linter has
# no "all other packages" wildcard; the test is what makes this default-deny.
#
# Direct imports only: these are entry points and tooling that legitimately
# reach infrastructure THROUGH the container, and checking chains would flag
# every such route rather than the edges that bypass it.
name = Packages outside the layers must not import infrastructure or tools directly
type = forbidden
allow_indirect_imports = True
source_modules =
    weebot.agents
    weebot.config
    weebot.mcp
    weebot.models
    weebot.osworld
    weebot.qmd_integration
    weebot.scheduling
    weebot.templates
    weebot.utils
forbidden_modules =
    weebot.infrastructure
    weebot.tools
ignore_imports =
    # mcp/server is an entry point (run_mcp.py) that builds and serves tools
    # itself. The plan also moved weebot/mcp into interfaces/, for governance;
    # this contract forbids it the same two packages interfaces-no-infra would,
    # so the move would relocate these six lines and gain no check.
    weebot.mcp.server -> weebot.infrastructure.adapters.composite_tool_executor
    weebot.mcp.server -> weebot.infrastructure.observability.metrics
    weebot.mcp.server -> weebot.tools.bash_tool
    weebot.mcp.server -> weebot.tools.file_editor
    weebot.mcp.server -> weebot.tools.python_tool
    weebot.mcp.server -> weebot.tools.web_search
    # osworld is a benchmark harness; it builds an OpenAI adapter directly and
    # is already a grandfathered bypass in test_llm_clients_are_built_by_the_factory.
    weebot.osworld.agent_adapter -> weebot.infrastructure.adapters.llm.openai_adapter
    # default_jobs records scheduler metrics directly.
    weebot.scheduling.default_jobs -> weebot.infrastructure.observability.metrics

[importlinter:contract:app-no-vendor-sdks]
# Phase 3.1, the anti-corruption layer. Application and domain speak to
# providers through ports; vendor SDKs and raw HTTP stay in infrastructure.
# Two leaks were closed to make this hold: verifying.py caught
# openai.AuthenticationError (so an Anthropic key failure slipped past it --
# now the domain LLMAuthenticationError, translated in ResilientLLMAdapter),
# and CascadeExecutor made raw httpx calls to openrouter.ai for credits and the
# live model list (now ProviderAccountPort).
# Direct imports only: the composition root reaches infrastructure by design.
name = Application and domain must not import provider SDKs or raw HTTP clients
type = forbidden
allow_indirect_imports = True
source_modules =
    weebot.application
    weebot.domain
forbidden_modules =
    openai
    anthropic
    httpx
    aiohttp
    requests
ignore_imports =
    # Pre-existing, and not provider traffic: webhook delivery and two web
    # research fetchers. Each wants a port the way the cascade got one.
    weebot.application.services.cron_delivery_service -> aiohttp
    weebot.application.services.multi_source_research -> aiohttp
    weebot.application.services.source_credibility_assessment -> aiohttp
