# ============================================================
# weebot — Environment Variables Reference
# ============================================================
# Copy this file to .env and fill in your values.
# Lines starting with # are comments.  Empty values are ignored.
# ============================================================


# ── AI Provider API Keys (at least ONE required) ─────────────
# OpenRouter — unified API for 350+ models (recommended)
OPENROUTER_API_KEY=

# DeepSeek — cost-efficient coding & reasoning
DEEPSEEK_API_KEY=

# Kimi — Moonshot AI
KIMI_API_KEY=

# Anthropic — Claude (optional, covered by OpenRouter)
ANTHROPIC_API_KEY=

# OpenAI — GPT-4 (optional, covered by OpenRouter)
OPENAI_API_KEY=


# ── Folders (all optional — defaults shown) ─────────────────
# Where weebot reads/writes files
# WEEBOT_WORKSPACE=.    (default: current directory)

# Where logs are written
# WEEBOT_LOGS_DIR=./logs

# Session database path
# WEEBOT_SESSIONS_DB=./weebot_sessions.db

# Cross-session memory files (AGENT.md / USER.md)
# WEEBOT_MEMORY_DIR=~/.weebot/memory

# User profile JSON storage
# WEEBOT_PROFILES_DIR=./user_profiles


# ── Defaults ─────────────────────────────────────────────────
# Default model (must be available via a configured provider)
# WEEBOT_MODEL=qwen/qwen3.7-plus

# Max AI spend per day in USD
DAILY_AI_BUDGET=10.0


# ── Sandbox ─────────────────────────────────────────────────
BASH_TIMEOUT=30
PYTHON_TIMEOUT=30
SANDBOX_MAX_OUTPUT_BYTES=65536
SANDBOX_ALLOW_NETWORK=false


# ── Atomic Mail (agent-owned inbox) ─────────────────────────
# Enable the AtomicMailTool (disabled by default — alpha service)
# WEEBOT_ENABLE_ATOMIC_MAIL=0

# Where @atomicmail.ai credentials are stored (default shown)
# ATOMIC_MAIL_CREDENTIALS_DIR=~/.atomicmail


# ── Browser Automation ──────────────────────────────────────
# Browser Use Cloud — purpose-built browser LLM (recommended)
# Get a key at https://cloud.browser-use.com
# BROWSER_USE_API_KEY=

BROWSER_HEADLESS=false
BROWSER_USE_VISION=true
BROWSER_TIMEOUT=30000


# ── Gateways: run weebot from chat apps ─────────────────────
# Start the web server (uvicorn / `python -m weebot.interfaces.web.main`)
# to enable gateways — Telegram polls in the background automatically;
# Slack/Discord receive events over the HTTP endpoints below.
#
# After setting credentials, allowlist the chats that may use the bot
# (denied by default):
#   python -m cli.main gateway allowlist add --platform telegram --id <chat_id>
#   python -m cli.main gateway allowlist add --platform slack --id <channel_id>
# Set WEEBOT_GATEWAY_AUTH_ENABLED=0 to disable the allowlist (not
# recommended for anything but a private, trusted deployment).

# Telegram — create a bot via @BotFather, paste the token here
TELEGRAM_BOT_TOKEN=
# Chat ID for standalone notification sends (`weebot.infrastructure.notifications`)
TELEGRAM_CHAT_ID=

# Slack — from your Slack app's "Basic Information" and "OAuth & Permissions"
# pages. Requires the Events API subscribed to `message.channels` /
# `app_mention`, request URL: https://<your-host>/api/gateway/slack/events
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

WEEBOT_GATEWAY_AUTH_ENABLED=true
