# ============================================================
# weebot — Environment Variables Reference
# ============================================================
# Copy this file to .env and fill in your values.
# Lines starting with # are comments.  Empty values are ignored.
# ============================================================


# ── AI Provider API Keys (at least ONE required) ─────────────
# OpenRouter — unified API for 350+ models (recommended)
OPENROUTER_API_KEY=

# DeepSeek — cost-efficient coding & reasoning
DEEPSEEK_API_KEY=

# Kimi — Moonshot AI
KIMI_API_KEY=

# Anthropic — Claude (optional, covered by OpenRouter)
ANTHROPIC_API_KEY=

# OpenAI — GPT-4 (optional, covered by OpenRouter)
OPENAI_API_KEY=


# ── Folders (all optional — defaults shown) ─────────────────
# Where weebot reads/writes files

# ── Valkey (event bus) ────────────────────────────────────────────────
VALKEY_PASSWORD=change_me_in_production
# WEEBOT_WORKSPACE=.    (default: current directory)

# Where logs are written
# WEEBOT_LOGS_DIR=./logs

# Session database path
# WEEBOT_SESSIONS_DB=./weebot_sessions.db

# Cross-session memory files (AGENT.md / USER.md)
# WEEBOT_MEMORY_DIR=~/.weebot/memory

# User profile JSON storage
# WEEBOT_PROFILES_DIR=./user_profiles


# ── Defaults ─────────────────────────────────────────────────
# Default model (must be available via a configured provider)
# WEEBOT_MODEL=qwen/qwen3.7-plus

# Max AI spend per day in USD
DAILY_AI_BUDGET=10.0


# ── Sandbox ─────────────────────────────────────────────────
BASH_TIMEOUT=30
PYTHON_TIMEOUT=30
SANDBOX_MAX_OUTPUT_BYTES=65536
SANDBOX_ALLOW_NETWORK=false


# ── Atomic Mail (agent-owned inbox) ─────────────────────────
# Enable the AtomicMailTool (disabled by default — alpha service)
# WEEBOT_ENABLE_ATOMIC_MAIL=0

# Where @atomicmail.ai credentials are stored (default shown)
# ATOMIC_MAIL_CREDENTIALS_DIR=~/.atomicmail


# ── X MCP (Model Context Protocol) ──────────────────────────
# X API MCP — full access via OAuth2 (requires X Developer app)
# Get credentials at https://developer.x.com/en/portal
X_CLIENT_ID=
X_CLIENT_SECRET=

# X API MCP — read-only app-only Bearer token (alternative to OAuth)
# Generate at https://developer.x.com/en/portal > Keys & Tokens
X_BEARER_TOKEN=


# ── Browser Automation ──────────────────────────────────────
# Browser Use Cloud — purpose-built browser LLM (recommended)
# Get a key at https://cloud.browser-use.com
# BROWSER_USE_API_KEY=

BROWSER_HEADLESS=false
BROWSER_USE_VISION=true
BROWSER_TIMEOUT=30000


# ── Gateways: run weebot from chat apps ─────────────────────
# Start the web server (uvicorn / `python -m weebot.interfaces.web.main`)
# to enable gateways — Telegram/Signal/Email poll in the background
# automatically; Slack/Discord/WhatsApp receive events over the HTTP
# endpoints below.
#
# After setting credentials, allowlist the chats that may use the bot
# (denied by default):
#   python -m cli.main gateway allowlist add --platform telegram --id <chat_id>
#   python -m cli.main gateway allowlist add --platform slack --id <channel_id>
#   python -m cli.main gateway allowlist add --platform whatsapp --id <phone_number>
#   python -m cli.main gateway allowlist add --platform signal --id <phone_number>
#   python -m cli.main gateway allowlist add --platform email --id <email_address>
# Set WEEBOT_GATEWAY_AUTH_ENABLED=0 to disable the allowlist (not
# recommended for anything but a private, trusted deployment).

# Telegram — create a bot via @BotFather, paste the token here
TELEGRAM_BOT_TOKEN=
# Chat ID for standalone notification sends (`weebot.infrastructure.notifications`)
TELEGRAM_CHAT_ID=

# Slack — from your Slack app's "Basic Information" and "OAuth & Permissions"
# pages. Requires the Events API subscribed to `message.channels` /
# `app_mention`, request URL: https://<your-host>/api/gateway/slack/events
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# WhatsApp — Meta Business Cloud API. Webhook request URL:
# https://<your-host>/api/gateway/whatsapp/webhook
# WHATSAPP_WEBHOOK_VERIFY_TOKEN is a string you choose yourself and enter
# into Meta's webhook setup page; WHATSAPP_APP_SECRET is optional and
# enables signature verification on incoming events.
WHATSAPP_BUSINESS_API_TOKEN=
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Signal — requires a local signal-cli REST API instance
# (https://github.com/bbernhard/signal-cli-rest-api) linked to a phone number.
SIGNAL_CLI_REST_URL=http://localhost:8080
SIGNAL_ACCOUNT_NUMBER=

# Email — IMAP polling + SMTP send. Use an app password, not your normal
# login password, for providers that support 2FA (e.g. Gmail).
EMAIL_IMAP_SERVER=imap.gmail.com
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_FROM_ADDRESS=
EMAIL_POLL_INTERVAL_SECONDS=30

WEEBOT_GATEWAY_AUTH_ENABLED=true


# ── Web API Security ─────────────────────────────────────────────
# Default bind address (127.0.0.1 = loopback; set to 0.0.0.0 to expose)
# WEEBOT_HOST=127.0.0.1

# When True and no WEEBOT_API_KEY is set, non-loopback requests get 503
# WEEBOT_WEB_REQUIRE_AUTH=true

# Optional independent API key for the /api/webhook/run endpoint
# WEEBOT_WEBHOOK_API_KEY=

# Allow webhook endpoint to use exec tools (bash, powershell, python_execute)
# WEEBOT_WEBHOOK_ALLOW_EXEC_TOOLS=false


# ── MCP Server Security ───────────────────────────────────────────
# API key for SSE/HTTP MCP transport. Required when using --allow-remote.
# WEEBOT_MCP_API_KEY=
