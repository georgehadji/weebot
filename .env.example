# ============================================================
# weebot — Environment Variables Reference
# ============================================================
# Auto-generated by scripts/generate_config_reference.py
# DO NOT EDIT BY HAND — regenerate: python scripts/generate_config_reference.py
# ============================================================

# OpenRouter API key for unified access to 350+ models
OPENROUTER_API_KEY=

# DeepSeek API key for direct coding/reasoning access
DEEPSEEK_API_KEY=

# Moonshot AI (Kimi) API key for direct access
KIMI_API_KEY=

# Anthropic Claude API key
ANTHROPIC_API_KEY=

# OpenAI API key
OPENAI_API_KEY=

# xAI (Grok) API key for direct access
XAI_API_KEY=

# Together AI API key
TOGETHER_API_KEY=

# Legacy global API key (bootstrap admin). Use per-principal keys via CLI instead.
WEEBOT_API_KEY=

# API key for remote SSE MCP transport (required when --allow-remote)
WEEBOT_MCP_API_KEY=

# API key for /api/webhook/run endpoint
WEEBOT_WEBHOOK_API_KEY=

# When true and no WEEBOT_API_KEY, refuse non-loopback requests with 503  (default: true)
WEEBOT_WEB_REQUIRE_AUTH=true

# Enforce chat-level allowlist for Discord/Slack/Telegram gateways  (default: true)
WEEBOT_GATEWAY_AUTH_ENABLED=true

# Web API bind address (0.0.0.0 to expose to network)  (default: 127.0.0.1)
WEEBOT_HOST=127.0.0.1

# Web API port number  (default: 8000)
WEEBOT_PORT=8000

# Additional CORS origin (besides localhost:3000 defaults)  (default: )
#WEEBOT_CORS_ORIGIN=

# Enable per-principal rate limiting middleware  (default: true)
WEEBOT_RATE_LIMIT_ENABLED=true

# Allow bash/powershell/python_execute tools via webhook endpoint (not recommended)  (default: false)
WEEBOT_WEBHOOK_ALLOW_EXEC_TOOLS=false

# Workspace root for file operations  (default: .)
WEEBOT_WORKSPACE=.

# Log output directory  (default: ./logs)
WEEBOT_LOGS_DIR=./logs

# SQLite session database path  (default: ./weebot_sessions.db)
WEEBOT_SESSIONS_DB=./weebot_sessions.db

# Persistent memory storage directory  (default: ~/.weebot/memory)
WEEBOT_MEMORY_DIR=~/.weebot/memory

# User profile storage directory  (default: ./user_profiles)
WEEBOT_PROFILES_DIR=./user_profiles

# Enable daily online backups to this directory  (default: )
#WEEBOT_BACKUP_DIR=

# Number of days to retain backups  (default: 30)
WEEBOT_BACKUP_RETENTION_DAYS=30

# Valkey password (set a strong value in production)  (default: weebot_default)
VALKEY_PASSWORD=weebot_default

# Maximum seconds for a single bash command  (default: 30)
BASH_TIMEOUT=30

# Maximum seconds for a single Python execution  (default: 30)
PYTHON_TIMEOUT=30

# Maximum bytes of sandbox output before truncation  (default: 65536)
SANDBOX_MAX_OUTPUT_BYTES=65536

# Allow network access from sandboxed code execution  (default: false)
SANDBOX_ALLOW_NETWORK=false

# Auto-approve all tool executions (dangerous — use only in trusted sandboxed envs)  (default: false)
WEEBOT_AUTO_APPROVE=false

# Override the default model ID for all roles  (default: )
#WEEBOT_MODEL=

# Maximum daily AI spend in USD  (default: 10.0)
DAILY_AI_BUDGET=10.0

# Ponytail lazy-senior-dev intensity: off|lite|full|ultra  (default: off)
WEEBOT_PONYTAIL_MODE=off

# Log level (DEBUG, INFO, WARNING, ERROR)  (default: INFO)
WEEBOT_LOG_LEVEL=INFO

# Log format: json|console|dev  (default: )
#WEEBOT_LOG_FORMAT=

# OpenTelemetry collector endpoint  (default: )
#WEEBOT_OTEL_ENDPOINT=

# Enable atomic-mail agent inbox (JMAP)  (default: 0)
WEEBOT_ENABLE_ATOMIC_MAIL=0

# Run Playwright browser in headless mode  (default: true)
BROWSER_HEADLESS=true

# Enforce egress guard (block outbound requests not in allowlist)  (default: true)
# Set to false only for detect-only mode (logs egress but does not block).
# This template used to ship `false`, contradicting the code default and
# silently disabling egress gating for bash, browser, telegram and outbound
# mail for anyone who copied it.
WEEBOT_EGRESS_ENFORCE=true

# Enforce user_id matching on session access  (default: false)
WEEBOT_ENFORCE_SESSION_OWNERSHIP=true

# Administrative secret for privileged operations
WEEBOT_ADMIN_SECRET=

# EXPERIMENTAL: enable raw-SQL migration scripts. Do not enable in production.  (default: false)
WEEBOT_ENABLE_UNSAFE_MIGRATION_SCRIPTS=false

# Allow unsigned WhatsApp webhooks (dev only)  (default: false)
WHATSAPP_ALLOW_UNSIGNED_WEBHOOKS=false

# Allow unsigned Stripe webhooks (dev only)  (default: false)
STRIPE_ALLOW_UNSIGNED_WEBHOOKS=false

# Enable live-network atomic mail tests (skipped by default in CI)  (default: 0)
ATOMICMAIL_TEST_LIVE=0

# Telegram bot token for gateway integration
TELEGRAM_BOT_TOKEN=

# Discord bot token for gateway integration
DISCORD_BOT_TOKEN=

# Slack bot token for gateway integration
SLACK_BOT_TOKEN=

# Slack signing secret for webhook verification
SLACK_SIGNING_SECRET=

# Signal account number for gateway integration  (default: )
#SIGNAL_ACCOUNT_NUMBER=

# IMAP server for email gateway  (default: )
#EMAIL_IMAP_SERVER=

# IMAP username for email gateway  (default: )
#EMAIL_IMAP_USER=

# IMAP password for email gateway
EMAIL_IMAP_PASSWORD=

# SMTP server for email gateway  (default: )
#EMAIL_SMTP_SERVER=

# SMTP port for email gateway  (default: 587)
EMAIL_SMTP_PORT=587

# From address for outgoing email gateway messages  (default: )
#EMAIL_FROM_ADDRESS=

# Email gateway IMAP poll interval  (default: 60)
EMAIL_POLL_INTERVAL_SECONDS=60

# GitNexus path override  (default: )
#GITNEXUS_PATH=

# Skip GitNexus embeddings  (default: false)
GITNEXUS_SKIP_EMBEDDINGS=false

# Force GitNexus reindex on startup  (default: false)
GITNEXUS_FORCE_REINDEX=false

# GitNexus analysis max depth  (default: 3)
GITNEXUS_MAX_DEPTH=3

# GitNexus minimum confidence threshold  (default: 0.7)
GITNEXUS_MIN_CONFIDENCE=0.7

# GitNexus operation timeout in seconds  (default: 120)
GITNEXUS_TIMEOUT=120

# GitNexus max retries  (default: 3)
GITNEXUS_MAX_RETRIES=3

# Default GitNexus repository path  (default: )
#GITNEXUS_DEFAULT_REPO_PATH=

# Enable GitNexus caching  (default: true)
GITNEXUS_ENABLE_CACHING=true

# GitNexus cache TTL in seconds  (default: 3600)
GITNEXUS_CACHE_TTL=3600

# Auto-analyze on startup  (default: false)
GITNEXUS_AUTO_ANALYZE=false

# Speech provider: openai|whisper|openrouter  (default: openai)
WEEBOT_SPEECH_PROVIDER=openai

# OpenAI API key for TTS (separate from OPENAI_API_KEY)
OPENAI_SPEECH_KEY=

# Enable composite tools in MCP server  (default: true)
WEEBOT_MCP_COMPOSITE_TOOLS_ENABLED=true

# Self-harness config version  (default: v0.2.0)
WEEBOT_HARNESS_VERSION=v0.2.0

# Enable agent behavior tracking system  (default: true)
WEEBOT_BEHAVIOR_TRACKING=true

# Gateway session TTL  (default: 3600)
WEEBOT_GATEWAY_SESSION_TTL_SECONDS=3600

# Max concurrent gateway sessions per platform  (default: 50)
WEEBOT_GATEWAY_MAX_SESSIONS_PER_PLATFORM=50

# Signal CLI REST API URL  (default: http://localhost:8080)
SIGNAL_CLI_REST_URL=http://localhost:8080

# Database backend: sqlite|postgresql  (default: sqlite)
WEEBOT_DB_BACKEND=sqlite

# PostgreSQL connection DSN (when DB_BACKEND=postgresql)
WEEBOT_PG_DSN=
