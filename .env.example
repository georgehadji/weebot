# OpenRouter API key for unified access to 350+ models
OPENROUTER_API_KEY=

# OpenRouter balance (USD) below which the cascade skips OpenRouter-only models  (default: 0.10)
OPENROUTER_MIN_CREDIT_USD=0.10

# DeepSeek API key for direct coding/reasoning access
DEEPSEEK_API_KEY=

# Moonshot AI (Kimi) API key for direct access
KIMI_API_KEY=

# Anthropic Claude API key
ANTHROPIC_API_KEY=

# OpenAI API key
OPENAI_API_KEY=

# xAI (Grok) API key for direct access
XAI_API_KEY=

# Use a local Ollama model for the roles in OLLAMA_ROLES (see docs/OLLAMA.md)  (default: false)
OLLAMA_ENABLED=false

# Ollama's OpenAI-compatible endpoint  (default: http://localhost:11434/v1)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Model tag from `ollama list`  (default: qwen3:8b)
OLLAMA_MODEL=qwen3:8b

# Context the model really has (num_ctx); Ollama's /v1 ignores a per-request value  (default: 4096)
OLLAMA_CONTEXT_WINDOW=4096

# Roles that try an Ollama model first: `role` or `role=tag` (e.g. verifier=gemma4:31b-cloud)  (default: summarizer,documentation)
OLLAMA_ROLES=summarizer,documentation

# Legacy global API key (bootstrap admin). Use per-principal keys via CLI instead.
WEEBOT_API_KEY=

# API key for remote SSE MCP transport (required when --allow-remote)
WEEBOT_MCP_API_KEY=

# API key for /api/webhook/run endpoint
WEEBOT_WEBHOOK_API_KEY=

# When true and no WEEBOT_API_KEY, refuse non-loopback requests with 503  (default: true)
WEEBOT_WEB_REQUIRE_AUTH=true

# Enforce chat-level allowlist for Discord/Slack/Telegram gateways  (default: true)
WEEBOT_GATEWAY_AUTH_ENABLED=true

# Web API bind address (0.0.0.0 to expose to network)  (default: 127.0.0.1)
WEEBOT_HOST=127.0.0.1

# Web API port number  (default: 8000)
WEEBOT_PORT=8000

# Additional CORS origin (besides localhost:3000 defaults)  (default: )
#WEEBOT_CORS_ORIGIN=

# Enable per-principal rate limiting middleware  (default: true)
WEEBOT_RATE_LIMIT_ENABLED=true

# Allow bash/powershell/python_execute tools via webhook endpoint (not recommended)  (default: false)
WEEBOT_WEBHOOK_ALLOW_EXEC_TOOLS=false

# Workspace root for file operations  (default: .)
WEEBOT_WORKSPACE=.

# Log output directory  (default: ./logs)
WEEBOT_LOGS_DIR=./logs

# SQLite session database path  (default: ./weebot_sessions.db)
WEEBOT_SESSIONS_DB=./weebot_sessions.db

# Persistent memory storage directory  (default: ~/.weebot/memory)
WEEBOT_MEMORY_DIR=~/.weebot/memory

# User profile storage directory  (default: ./user_profiles)
WEEBOT_PROFILES_DIR=./user_profiles

# Enable daily online backups to this directory  (default: )
#WEEBOT_BACKUP_DIR=

# Valkey password. The default is for local docker compose only: the Valkey service publishes no port (pinned by tests/unit/test_compose_valkey_unpublished.py). Set your own value before publishing it  (default: weebot_default)
VALKEY_PASSWORD=weebot_default

# Per-session spend (USD) above which the cascade skips PREMIUM models for the rest of the session; 0 disables  (default: 0.5)
WEEBOT_SESSION_COST_SOFT_USD=0.5

# Per-session spend (USD) at which the flow asks to continue, then ends as BUDGET_EXCEEDED if refused; 0 disables  (default: 2.5)
WEEBOT_SESSION_COST_HARD_USD=2.5

# Maximum seconds for a single bash command  (default: 30)
BASH_TIMEOUT=30

# Maximum seconds for a single Python execution  (default: 30)
PYTHON_TIMEOUT=30

# Maximum bytes of sandbox output before truncation  (default: 65536)
SANDBOX_MAX_OUTPUT_BYTES=65536

# Allow network access from sandboxed code execution  (default: false)
SANDBOX_ALLOW_NETWORK=false

# auto (native on Windows, Docker elsewhere), docker_first, native, docker, wsl2  (default: auto)
SANDBOX_MODE=auto

# Refuse sandboxed calls on a backend that cannot enforce network-off (ADR-014)  (default: false)
SANDBOX_REQUIRE_ISOLATION=false

# Set to 1 to auto-approve CLI tool approvals (dangerous — trusted sandboxed envs only); any other value asks  (default: )
#WEEBOT_AUTO_APPROVE=

# Tool guard chain mode: 'observe' (record only) or 'enforce' (refuse)  (default: enforce)
WEEBOT_SHELL_GUARD_MODE=enforce

# Financial/payment tools always ask before running (observe mode logs only)  (default: true)
FINANCIAL_TOOLS_ALWAYS_ASK=true

# Comma-separated globs (case-insensitive) naming financial/payment tools  (default: *stripe*,*payment*,*invoice*,*refund*,*payout*,*checkout*,*billing*)
WEEBOT_FINANCIAL_TOOL_PATTERNS=*stripe*,*payment*,*invoice*,*refund*,*payout*,*checkout*,*billing*

# Comma-separated globs naming tools that publish, send or spend; they always ask  (default: *schedulepost*,*deletepost*,*publish*,*send_email*,*send_mail*,*send_reply*,*send_message*,*tweet*,*generate*,*clipping*,apify_*,image_gen,video_gen,mixture_of_agents)
WEEBOT_OUTBOUND_TOOL_PATTERNS=*schedulepost*,*deletepost*,*publish*,*send_email*,*send_mail*,*send_reply*,*send_message*,*tweet*,*generate*,*clipping*,apify_*,image_gen,video_gen,mixture_of_agents

# Outbound tools ask through the approval channel even in observe mode  (default: true)
WEEBOT_OUTBOUND_ASK_IN_OBSERVE=true

# Path to agent-reach.exe for the agent_reach tool (else PATH, else ~/.agent-reach-venv)  (default: )
#AGENT_REACH_PATH=

# Path to moli.exe for the moli_fetch tool (else PATH, else %LOCALAPPDATA%\Moli\bin)  (default: )
#MOLI_PATH=

# camofox-browser package folder for camofox_browser (else ~/.camofox-browser)  (default: )
#CAMOFOX_PATH=

# Folder with Remotion installed, for remotion_video (else ~/.weebot-remotion)  (default: )
#REMOTION_HOST=

# Seconds the pre-planning intent review may take; on timeout it fails open  (default: 30.0)
WEEBOT_INTENT_REVIEW_TIMEOUT_S=30.0

# Maximum daily AI spend in USD  (default: 10.0)
DAILY_AI_BUDGET=10.0

# Ponytail lazy-senior-dev intensity: off|lite|full|ultra  (default: off)
WEEBOT_PONYTAIL_MODE=off

# Log level (DEBUG, INFO, WARNING, ERROR)  (default: INFO)
WEEBOT_LOG_LEVEL=INFO

# Log format: json|console|dev  (default: )
#WEEBOT_LOG_FORMAT=

# Enable atomic-mail agent inbox (JMAP)  (default: 0)
WEEBOT_ENABLE_ATOMIC_MAIL=0

# Run Playwright browser in headless mode  (default: true)
BROWSER_HEADLESS=true

# Enforce egress guard (block outbound requests not in allowlist)  (default: true)
WEEBOT_EGRESS_ENFORCE=true

# Enforce user_id matching on session access  (default: true)
WEEBOT_ENFORCE_SESSION_OWNERSHIP=true

# Shell commands no approval rule covers: off, observe (log what would ask) or enforce  (default: observe)
WEEBOT_SHELL_DEFAULT_ASK=observe

# The UI proxy fronts this API: loopback no longer counts as identity for mutations, so they need an API key  (default: false)
WEEBOT_BEHIND_PROXY=false

# Largest request body the web API accepts (413 above it)  (default: 1048576)
WEEBOT_MAX_BODY_BYTES=1048576

# Allow unsigned WhatsApp webhooks (dev only)  (default: false)
WHATSAPP_ALLOW_UNSIGNED_WEBHOOKS=false

# Allow unsigned Stripe webhooks (dev only)  (default: false)
STRIPE_ALLOW_UNSIGNED_WEBHOOKS=false

# Enable live-network atomic mail tests (skipped by default in CI)  (default: 0)
ATOMICMAIL_TEST_LIVE=0

# Telegram bot token for gateway integration
TELEGRAM_BOT_TOKEN=

# Discord bot token for gateway integration
DISCORD_BOT_TOKEN=

# Slack bot token for gateway integration
SLACK_BOT_TOKEN=

# Slack signing secret for webhook verification
SLACK_SIGNING_SECRET=

# Signal account number for gateway integration  (default: )
#SIGNAL_ACCOUNT_NUMBER=

# IMAP server for email gateway  (default: imap.gmail.com)
EMAIL_IMAP_SERVER=imap.gmail.com

# IMAP username for email gateway  (default: )
#EMAIL_IMAP_USER=

# IMAP password for email gateway
EMAIL_IMAP_PASSWORD=

# SMTP server for email gateway  (default: smtp.gmail.com)
EMAIL_SMTP_SERVER=smtp.gmail.com

# SMTP port for email gateway  (default: 587)
EMAIL_SMTP_PORT=587

# From address for outgoing email gateway messages  (default: )
#EMAIL_FROM_ADDRESS=

# Email gateway IMAP poll interval  (default: 30.0)
EMAIL_POLL_INTERVAL_SECONDS=30.0

# Enable composite tools in MCP server  (default: true)
WEEBOT_MCP_COMPOSITE_TOOLS_ENABLED=true

# Self-harness config version  (default: v0.2.0)
WEEBOT_HARNESS_VERSION=v0.2.0

# Enable agent behavior tracking system  (default: true)
WEEBOT_BEHAVIOR_TRACKING=true

# Gateway session TTL  (default: 604800)
WEEBOT_GATEWAY_SESSION_TTL_SECONDS=604800

# Max concurrent gateway sessions per platform  (default: 100)
WEEBOT_GATEWAY_MAX_SESSIONS_PER_PLATFORM=100

# Signal CLI REST API URL  (default: http://localhost:8080)
SIGNAL_CLI_REST_URL=http://localhost:8080

# Score each step's progress on the verifier model; a stalled step is replanned  (default: false)
WEEBOT_STEP_EVALUATOR=false

# Chain-of-verification veto before a learned skill is promoted to trusted  (default: false)
WEEBOT_SKILL_PROMOTION_GATE=false

# SkillOpt validates a candidate on a 10-task probe first and stops if it scores low  (default: false)
WEEBOT_STAGED_VALIDATION=false

# Scorer for sessions with an expected answer: plan_outcome|exact|execution|verifier  (default: plan_outcome)
WEEBOT_SCORING_MODE=plan_outcome

# Save summaries of successful runs and show them when planning similar tasks  (default: false)
WEEBOT_EPISODIC_SUMMARIES=false

# Save the plan after each step so `flow recover` can resume an interrupted run  (default: false)
WEEBOT_FLOW_CHECKPOINTS=false

# Offer approaches that worked on other kinds of task when planning  (default: false)
WEEBOT_STRATEGY_TRANSFER=false

# Event bus: local, or valkey to share events between processes (WEEBOT_VALKEY_URL)  (default: local)
WEEBOT_EVENT_BUS=local

# Windows desktop toasts for errors, questions and finished runs (web backend)  (default: false)
WEEBOT_WINDOWS_TOAST=false

# Voice tools backend: whisper (local extras) or openrouter (billed, audio leaves)  (default: whisper)
WEEBOT_SPEECH_BACKEND=whisper

# Database backend: sqlite|postgresql  (default: sqlite)
WEEBOT_DB_BACKEND=sqlite

# PostgreSQL connection DSN (when DB_BACKEND=postgresql)
WEEBOT_PG_DSN=
